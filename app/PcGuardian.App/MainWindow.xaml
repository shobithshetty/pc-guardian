<Window x:Class="PcGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pc-guardian" Width="980" Height="690" MinWidth="780" MinHeight="520"
        Icon="Assets/pc-guardian.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        SourceInitialized="Window_SourceInitialized">
    <DockPanel>
    <Menu DockPanel.Dock="Top">
        <MenuItem Header="_File">
            <MenuItem Header="_Quick check" Click="QuickCheck_Click"/>
            <MenuItem Header="_Full scan" Click="Scan_Click"/>
            <Separator/>
            <MenuItem Header="_Settings..." InputGestureText="Ctrl+," Click="Settings_Click"/>
            <Separator/>
            <MenuItem Header="E_xit" Click="Exit_Click"/>
        </MenuItem>
        <MenuItem Header="_View">
            <MenuItem Header="_Safe list..." Click="SafeList_Click"/>
            <MenuItem Header="_Refresh protection status" Click="RefreshStatus_Click"/>
        </MenuItem>
        <MenuItem Header="_Help">
            <MenuItem Header="_About and credits" Click="About_Click"/>
        </MenuItem>
    </Menu>
    <Grid Margin="24,10,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="46" Height="46">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="ShieldPath" Fill="{DynamicResource Good}"
                              Data="M12,2 L20.5,5.2 L20.5,11 C20.5,16.2 16.9,20.4 12,22 C7.1,20.4 3.5,16.2 3.5,11 L3.5,5.2 Z"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Headline" FontSize="22" FontWeight="SemiBold" Text="Starting..."/>
                    <TextBlock x:Name="Subline" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MarkAllButton" Content="Mark all as safe" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="MarkAll_Click"/>
                    <Button x:Name="ScanButton" Content="Scan now" Style="{StaticResource PrimaryButton}" Click="Scan_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <!-- One-time setup, shown only when protection data is missing -->
            <Border x:Name="SetupCard" Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="SetupButton" DockPanel.Dock="Right" Content="Download and scan" Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center" Margin="16,0,0,0" Click="Setup_Click"/>
                    <StackPanel>
                        <TextBlock Text="Download protection data to turn on virus scanning" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SetupText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Shown when a scan or download finishes, and stays until dismissed -->
            <Border x:Name="ResultCard" Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0" Visibility="Collapsed" BorderThickness="2">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource SoftButton}" Padding="14,5" VerticalAlignment="Center" Click="DismissResult_Click"/>
                    <Viewbox DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,16,0">
                        <Canvas Width="24" Height="24">
                            <Ellipse x:Name="ResultDot" Width="24" Height="24" Fill="{DynamicResource Good}"/>
                            <Polyline Points="7,12.5 10.5,16 17,8.5" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ResultDetail" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Live progress for scans and downloads -->
            <Border x:Name="ProgressCard" Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SoftButton}" Padding="14,5" Click="Cancel_Click"/>
                        <TextBlock x:Name="StepText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar x:Name="Bar" Style="{StaticResource ModernBar}" Margin="0,12,0,12" Minimum="0" Maximum="1"/>
                    <TextBlock x:Name="CurrentText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="StatsText" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="18,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PillInfoBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Alert">
                                                            <Setter Property="Background" Value="{DynamicResource PillAlertBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Threat">
                                                            <Setter Property="Background" Value="{DynamicResource PillThreatBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Level}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource PillInfoFg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Alert">
                                                                <Setter Property="Foreground" Value="{DynamicResource PillAlertFg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Threat">
                                                                <Setter Property="Foreground" Value="{DynamicResource PillThreatFg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"/>
                                            <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="40"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" ToolTip="{Binding Detail}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Mark as safe" Style="{StaticResource SoftButton}" Padding="12,5"
                                                VerticalAlignment="Center" Tag="{Binding}" Click="MarkSafe_Click" IsEnabled="{Binding CanMarkSafe}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="Nothing to review." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="4,10,0,0">
            <TextBlock x:Name="ProtectionText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
