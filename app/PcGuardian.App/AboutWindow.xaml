<Window x:Class="PcGuardian.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About pc-guardian" Width="560" Height="640" MinWidth="460" MinHeight="420"
        Icon="Assets/pc-guardian.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        SourceInitialized="Window_SourceInitialized">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,10,24,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SoftButton}" Click="Close_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SponsorButton" Content="Support the project" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="Sponsor_Click" Visibility="Collapsed"/>
                    <Button x:Name="ProjectButton" Content="Project page" Style="{StaticResource SoftButton}" Padding="14,6" Margin="8,0,0,0" Click="Project_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="NoLinks" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Text="Project and sponsor links appear here once the project is published."/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,12">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="56" Height="56">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource Good}" Data="M12,2 L20.5,5.2 L20.5,11 C20.5,16.2 16.9,20.4 12,22 C7.1,20.4 3.5,16.2 3.5,11 L3.5,5.2 Z"/>
                            <Polyline Points="8,12 11,15 16.5,9" Stroke="White" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="pc-guardian" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                    <TextBlock x:Name="CreditsText" TextWrapping="Wrap" LineHeight="22"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
