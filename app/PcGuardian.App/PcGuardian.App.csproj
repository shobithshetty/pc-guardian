<Project Sdk="Microsoft.NET.Sdk">

  <!-- No NuGet packages on purpose: fewer dependencies means a smaller supply-chain attack surface. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PcGuardian</AssemblyName>
    <RootNamespace>PcGuardian.App</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\pc-guardian.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The window icon is compiled in; the same file is the .exe icon (ApplicationIcon above). -->
  <ItemGroup>
    <Resource Include="Assets\pc-guardian.ico" />
  </ItemGroup>


  <!-- Ship the PowerShell engine next to the .exe so the installed app is self-contained. -->
  <ItemGroup>
    <Content Include="..\..\src\PcGuardian\**\*" Exclude="..\..\src\PcGuardian\**\*.Tests.ps1">
      <Link>module\PcGuardian\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The one-off clean-up for a daily scan task that an older version scheduled (Settings offers it). -->
    <Content Include="..\..\installer\RemoveDailyScan.ps1">
      <Link>tools\RemoveDailyScan.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
